# Copy to .env and fill in real values for docker-compose.yml (production-shaped
# local run). docker-compose.dev.yml does not read this file — it sets its own
# container-network-appropriate values directly in the compose file.

NODE_ENV=production
PORT=3000

# Neon (managed Postgres) connection string. Use the *unpooled* URL if this
# process ever runs migrations; the app itself should use the pooled one.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

AWS_REGION=eu-central-1
SQS_PRESCREEN_QUEUE_URL=https://sqs.eu-central-1.amazonaws.com/000000000000/marketplace-prescreen
S3_PHOTOS_BUCKET=marketplace-catalog-photos

# Signs the auth cookie's JWT (MAR-12). Generate with: openssl rand -hex 32
JWT_SECRET=changeme

# Only set for LocalStack; omit entirely against real AWS.
# SQS_ENDPOINT=http://localhost:4566

# Only needed where nothing else supplies AWS credentials (local dev without
# an `aws configure`d profile, or CI). In production the EC2 instance role
# provides them automatically (MAR-43) — leave these unset there.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
