# The EC2 deploy target's connection to registry.npmjs.org is measurably
# slow (individual metadata requests regularly take 10-45s), which pnpm's
# defaults (60s fetch-timeout, 2 retries, 16-way concurrency) aren't tuned
# for — several prod deploys timed out here. Lower concurrency avoids
# piling on an already-slow/throttled connection; higher timeout and
# retry counts give a genuinely slow (not dead) request room to finish.
fetch-timeout=300000
fetch-retries=5
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
network-concurrency=6
