# The EC2 deploy target's connection to registry.npmjs.org is measurably
# slow (individual metadata requests regularly take 10-45s), which pnpm's
# defaults (60s fetch-timeout, 2 retries) aren't tuned for — several prod
# deploys timed out here. Higher timeout and retry counts give a
# genuinely slow (not dead) request room to finish. Concurrency is left
# at pnpm's default: an earlier attempt lowered it to 6 assuming
# concurrent requests were overwhelming a throttled link, but at this
# per-request latency that just serializes hundreds of resolves into a
# 20+ minute wall-clock hang — the bottleneck is latency, not contention.
fetch-timeout=300000
fetch-retries=5
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
